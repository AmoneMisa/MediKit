# Copy to .env and adjust as needed.
PORT=4000
# Secret used to sign JWTs. CHANGE THIS in production.
JWT_SECRET=change-me-in-production

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Either set DATABASE_URL directly...
# DATABASE_URL=postgres://medikit:medikit@localhost:5432/medikit
# ...or provide the individual parts (used by docker-compose too):
PGUSER=medikit
PGPASSWORD=medikit
PGHOST=localhost
PGPORT=5432
PGDATABASE=medikit

# Set to 'false' to disable live openFDA/RxNav lookups (offline/air-gapped).
ENABLE_GLOBAL_SOURCES=true

# ─── Google Sign-In ──────────────────────────────────────────────────────────
# OAuth client ID(s) accepted as the audience when verifying Google ID tokens.
# Use the WEB client ID from Google Cloud Console (the one passed to the app's
# GoogleSignin.configure webClientId). Comma-separate to trust several.
# Leave empty to disable Google sign-in (endpoint returns 503).
GOOGLE_CLIENT_ID=

# ─── Label scanning (AI vision) ───────────────────────────────────────────────
# Groq key used server-side to scan medicine package photos. Free tier: 14,400
# req/day. Get one at console.groq.com → API Keys → Create.
# Leave empty to disable label scanning (endpoint returns 503).
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Gemini key — fallback vision provider, tried if Groq is unconfigured or fails.
# Get one at aistudio.google.com/apikey. Leave empty to skip this provider.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
